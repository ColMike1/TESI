#        ROUNDING
vlog src/max_shift_7/withRounding/AdderHiF8_maxShift7_withRounding.v
vlog tb/max_shift_7/withRounding/tb_adder_hif8.v





# avvia simulazione 
vsim -voptargs="+acc" work.tb_adder_HiF8

# segnali
# add wave -position insertpoint sim:/...

# esegui simulazione
run -all

