if {[file exists work]} {
    vdel -lib work -all
}


vlib work

# compilazione
vlog src/HiFloat8_to_FP_converter.v
vlog src/FP_to_HiFloat8_converter.v


# ======== MAX_SHIFT=4 ===========

#        NO_ROUNDING
# vlog src/max_shift_4/noRounding/AdderHiF8_maxShift4_noRounding.v
