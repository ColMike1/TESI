if {[file exists work]} {
    vdel -lib work -all
}


vlib work

# compilazione
vlog src/HiFloat8_to_FP_converter.v
vlog src/FP_to_HiFloat8_converter.v


vlog tb/tb_HF8_FP.sv
vlog tb/tb_FP_HF8.sv
vlog tb/tb_FP_HF8_FP.sv
vlog tb/tb_HF8_FP_HF8.sv


# avvia simulazione 
