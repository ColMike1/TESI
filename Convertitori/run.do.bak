# vsim -voptargs="+acc" work.tb_HF8_FP_HF8
vsim -voptargs="+acc" work.tb_HF8_FP
#vsim -voptargs="+acc" work.tb_FP_HF8



# segnali
# add wave -position insertpoint sim:/tb_FP_to_HF8_to_FP/*
